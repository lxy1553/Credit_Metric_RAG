# Local learning only. The API refuses to start without this explicit flag.
CREDIT_DEMO_MODE=1
# Local only: demo. Production: oidc (requires the variables below and `.[auth]`).
CREDIT_AUTH_MODE=demo
# CREDIT_OIDC_ISSUER=https://issuer.example.com
# CREDIT_OIDC_AUDIENCE=credit-datahouse-api
# CREDIT_OIDC_JWKS_URL=https://issuer.example.com/.well-known/jwks.json
# CREDIT_OIDC_ROLES_CLAIM=roles
# CREDIT_OIDC_DOMAINS_CLAIM=domains
# CREDIT_OIDC_POLICY_VERSION_CLAIM=policy_version
CREDIT_DB=var/credit.db
CREDIT_MEMORY=memory
# Exact certified knowledge cache: memory, redis, or off. Redis uses CREDIT_REDIS_URL.
CREDIT_RESPONSE_CACHE=memory
# Optional external intent classification only. The question text is sent to DeepSeek when enabled.
# Copy this file to .env, set the API key, then explicitly enable the router.
# CREDIT_INTENT_ROUTER=deepseek
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_TIMEOUT_SECONDS=4
# Stage 5 local SLO evaluator. It never sends external notifications.
CREDIT_SLO_MIN_SAMPLES=20
CREDIT_SLO_P95_MS=500
# To use Redis: CREDIT_MEMORY=redis and CREDIT_REDIS_URL=redis://127.0.0.1:6389/0
# Optional shared async tasks for local multi-process acceptance. Start the isolated
# service with: docker compose --profile task-queue up -d task-redis
# Generate a unique 32-byte key locally and keep the actual value only in .env:
#   .venv/bin/python -c 'import secrets; print(secrets.token_hex(32))'
# CREDIT_TASK_BACKEND=redis
# CREDIT_TASK_REDIS_URL=redis://127.0.0.1:6390/0
# CREDIT_TASK_KEYRING={"local-v1":"REPLACE_WITH_64_HEX_CHAR_KEY"}
# CREDIT_TASK_ACTIVE_KEY_ID=local-v1
# CREDIT_TASK_WORKERS=1
# CREDIT_MEMORY=redis
# CREDIT_REDIS_URL=redis://127.0.0.1:6390/0
# To use hybrid retrieval after indexing:
# CREDIT_RETRIEVAL=elasticsearch
# CREDIT_ELASTICSEARCH_URL=http://127.0.0.1:9200
# CREDIT_ELASTICSEARCH_INDEX=credit-knowledge-current
# CREDIT_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# CREDIT_MODEL_CACHE=var/models
# Bearer demo-analyst / demo-operator / demo-visitor are synthetic local identities.
